DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE empty or unset to use local SQLite.
# Set DB_ENGINE=postgres to use Supabase Postgres.
DB_ENGINE=
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
